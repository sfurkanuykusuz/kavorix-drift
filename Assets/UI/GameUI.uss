/* ================================================== */
/* SHARED FONT                                        */
/* ================================================== */

.hud-label,
.new-high-score-label,
.game-button,
.power-up-title,
.rotate-warning-text,
.countdown-label,
.completion-bonus-label {
    -unity-font-definition: url("project://database/Assets/Fonts/Michroma-Regular.ttf?fileID=12800000&guid=f88f7ddf669031c47b3157a4d475a48d&type=3#Michroma-Regular");
}


/* ================================================== */
/* SCORE FEEDBACK                                     */
/* ================================================== */

.new-high-score-text {
    opacity: 0;
    scale: 0.84;

    transition-property: opacity, scale;
    transition-duration: 0.3s;
}

.new-high-score-text-show {
    opacity: 1;
    scale: 1;
}

.high-score-flash {
    scale: 1.04;

    transition-property: scale;
    transition-duration: 0.16s;
}


/* ================================================== */
/* HUD / GAME OVER LABELS                             */
/* ================================================== */

.hud-label {
    position: absolute;

    min-width: 128px;
    max-width: 86%;

    color: rgb(255, 255, 255);
    background-color: rgba(16, 22, 39, 0.58);

    -unity-font-style: normal;
    -unity-text-align: middle-center;

    font-size: 14px;

    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;

    border-top-color: rgb(40, 133, 188);
    border-right-color: rgb(40, 133, 188);
    border-bottom-color: rgb(40, 133, 188);
    border-left-color: rgb(40, 133, 188);

    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;

    padding-top: 5px;
    padding-right: 12px;
    padding-bottom: 5px;
    padding-left: 12px;

    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.score-label {
    left: 50%;
    top: 12px;

    translate: -50% 0;
}

.high-score-label {
    left: 50%;
    top: 56px;

    translate: -50% 0;

    min-width: 198px;
}

.new-high-score-label {
    position: absolute;

    left: 50%;
    top: 104px;

    translate: -50% 0;

    min-width: 198px;
    max-width: 86%;

    color: rgb(255, 230, 120);
    background-color: rgba(16, 22, 39, 0.68);

    -unity-font-style: bold;
    -unity-text-align: middle-center;

    font-size: 14px;

    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;

    border-top-color: rgb(255, 210, 90);
    border-right-color: rgb(255, 210, 90);
    border-bottom-color: rgb(255, 210, 90);
    border-left-color: rgb(255, 210, 90);

    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;

    padding-top: 5px;
    padding-right: 12px;
    padding-bottom: 5px;
    padding-left: 12px;

    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.obstacle-count-label {
    right: 18px;
    bottom: 18px;

    min-width: 132px;

    display: none;
}


/* ================================================== */
/* SHARED BUTTON STYLE                                */
/* ================================================== */

.game-button {
    scale: 1;

    width: 158px;
    height: 54px;

    background-color: rgba(16, 22, 39, 0.51);
    color: rgb(255, 255, 255);

    -unity-font-style: normal;
    -unity-text-align: middle-center;

    font-size: 17px;

    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;

    border-top-color: rgb(40, 133, 188);
    border-right-color: rgb(40, 133, 188);
    border-bottom-color: rgb(40, 133, 188);
    border-left-color: rgb(40, 133, 188);

    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
    border-bottom-left-radius: 9px;

    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;

    transition-property: scale, background-color, border-top-color, border-right-color, border-bottom-color, border-left-color;
    transition-duration: 0.15s;
}

.game-button:hover {
    scale: 1.03;

    background-color: rgba(60, 160, 210, 0.35);

    border-top-color: rgb(100, 220, 255);
    border-right-color: rgb(100, 220, 255);
    border-bottom-color: rgb(100, 220, 255);
    border-left-color: rgb(100, 220, 255);
}


/* ================================================== */
/* MAIN MENU                                          */
/* ================================================== */

.main-menu-panel {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    display: flex;

    justify-content: center;
    align-items: center;
    flex-direction: column;

    padding-top: 32px;
    padding-right: 24px;
    padding-bottom: 32px;
    padding-left: 24px;
}

.menu-play-button {
    position: relative;

    width: 176px;
    height: 56px;

    font-size: 18px;

    margin-bottom: 18px;
}

.menu-exit-button {
    position: relative;

    width: 176px;
    height: 56px;

    font-size: 18px;
}


/* ================================================== */
/* GAME OVER BUTTONS                                  */
/* ================================================== */

.restart-button-game-over {
    position: absolute;

    right: 18px;
    top: 16px;

    width: 138px;
    height: 44px;

    font-size: 14px;
}

.exit-button-game-over {
    position: absolute;

    left: 50%;
    bottom: 18px;

    translate: -50% 0;

    width: 148px;
    height: 44px;

    font-size: 14px;
}

.game-over-button-enter {
    opacity: 0;
    scale: 0.9;

    transition-property: opacity, scale, background-color, border-top-color, border-right-color, border-bottom-color, border-left-color;
    transition-duration: 0.22s;
}

.game-over-button-enter-show {
    opacity: 1;
    scale: 1;
}

.game-over-button-enter-show:hover {
    scale: 1.03;

    background-color: rgba(60, 160, 210, 0.35);

    border-top-color: rgb(100, 220, 255);
    border-right-color: rgb(100, 220, 255);
    border-bottom-color: rgb(100, 220, 255);
    border-left-color: rgb(100, 220, 255);
}


/* ================================================== */
/* POWER-UP CHOICE PANEL                              */
/* ================================================== */

.power-up-choice-panel {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    display: none;

    justify-content: center;
    align-items: center;
    flex-direction: column;

    padding-top: 32px;
    padding-right: 24px;
    padding-bottom: 32px;
    padding-left: 24px;

    background-color: rgba(5, 8, 18, 0.78);
}

.power-up-title {
    max-width: 86%;

    color: rgb(255, 255, 255);

    -unity-font-style: bold;
    -unity-text-align: middle-center;

    font-size: 19px;

    margin-bottom: 20px;
}

.power-up-button {
    width: 236px;
    height: 58px;

    font-size: 15px;
}

.missile-button {
    margin-bottom: 14px;

    border-top-color: rgb(255, 120, 80);
    border-right-color: rgb(255, 120, 80);
    border-bottom-color: rgb(255, 120, 80);
    border-left-color: rgb(255, 120, 80);
}

.shield-button {
    border-top-color: rgb(80, 190, 255);
    border-right-color: rgb(80, 190, 255);
    border-bottom-color: rgb(80, 190, 255);
    border-left-color: rgb(80, 190, 255);
}

.missile-button:hover {
    background-color: rgba(255, 120, 80, 0.25);

    border-top-color: rgb(255, 190, 150);
    border-right-color: rgb(255, 190, 150);
    border-bottom-color: rgb(255, 190, 150);
    border-left-color: rgb(255, 190, 150);
}

.shield-button:hover {
    background-color: rgba(80, 190, 255, 0.25);

    border-top-color: rgb(150, 230, 255);
    border-right-color: rgb(150, 230, 255);
    border-bottom-color: rgb(150, 230, 255);
    border-left-color: rgb(150, 230, 255);
}


/* ================================================== */
/* ROTATE WARNING                                     */
/* ================================================== */

.rotate-warning-overlay {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    display: none;

    justify-content: center;
    align-items: center;

    padding-top: 32px;
    padding-right: 24px;
    padding-bottom: 32px;
    padding-left: 24px;

    background-color: rgba(5, 8, 18, 0.95);
}

.rotate-warning-text {
    max-width: 86%;

    color: rgb(255, 255, 255);
    background-color: rgba(16, 22, 39, 0.9);

    font-size: 20px;

    -unity-font-style: bold;
    -unity-text-align: middle-center;

    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;

    border-top-color: rgb(40, 133, 188);
    border-right-color: rgb(40, 133, 188);
    border-bottom-color: rgb(40, 133, 188);
    border-left-color: rgb(40, 133, 188);

    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;

    padding-top: 16px;
    padding-right: 22px;
    padding-bottom: 16px;
    padding-left: 22px;
}


/* ================================================== */
/* COUNTDOWN                                          */
/* ================================================== */

.countdown-label {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    width: 100%;
    height: 100%;

    display: none;

    color: rgb(255, 255, 255);

    -unity-font-style: bold;
    -unity-text-align: middle-center;

    font-size: 72px;

    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;

    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}


/* ================================================== */
/* COMPLETION BONUS                                   */
/* ================================================== */

.completion-bonus-label {
    position: absolute;

    left: 50%;
    top: 154px;

    translate: -50% 0;

    min-width: 220px;
    max-width: 86%;

    display: none;

    opacity: 0;
    scale: 0.9;

    color: rgb(255, 220, 90);
    background-color: rgba(16, 22, 39, 0.72);

    -unity-font-style: bold;
    -unity-text-align: middle-center;

    font-size: 14px;

    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;

    border-top-color: rgb(255, 190, 80);
    border-right-color: rgb(255, 190, 80);
    border-bottom-color: rgb(255, 190, 80);
    border-left-color: rgb(255, 190, 80);

    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
    border-bottom-left-radius: 9px;

    padding-top: 6px;
    padding-right: 12px;
    padding-bottom: 6px;
    padding-left: 12px;

    transition-property: opacity, scale;
    transition-duration: 0.3s;
}

.completion-bonus-label-show {
    opacity: 1;
    scale: 1;
}


