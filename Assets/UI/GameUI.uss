/* ================================================== */
/* SCORE FEEDBACK                                     */
/* ================================================== */

.new-high-score-text {
    opacity: 0;
    scale: 0.8;

    transition-property: opacity, scale;
    transition-duration: 0.35s;
}

.new-high-score-text-show {
    opacity: 1;
    scale: 1.15;
}

.high-score-flash {
    scale: 1.2;

    transition-property: scale;
    transition-duration: 0.18s;
}


/* ================================================== */
/* SHARED BUTTON STYLE                                */
/* Used by Play, Exit, and Restart buttons.           */
/* ================================================== */

.game-button {
    scale: 1;

    width: 180px;
    height: 70px;

    background-color: rgba(16, 22, 39, 0.51);
    color: rgb(255, 255, 255);

    -unity-font-definition: url("project://database/Assets/Fonts/Michroma-Regular.ttf?fileID=12800000&guid=f88f7ddf669031c47b3157a4d475a48d&type=3#Michroma-Regular");
    -unity-font-style: normal;
    -unity-text-align: middle-center;

    font-size: 22px;

    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;

    border-top-color: rgb(40, 133, 188);
    border-right-color: rgb(40, 133, 188);
    border-bottom-color: rgb(40, 133, 188);
    border-left-color: rgb(40, 133, 188);

    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;

    transition-property: scale, background-color, border-top-color, border-right-color, border-bottom-color, border-left-color;
    transition-duration: 0.15s;
}

.game-button:hover {
    scale: 1.08;

    background-color: rgba(60, 160, 210, 0.35);
    color: rgb(255, 255, 255);

    border-top-color: rgb(100, 220, 255);
    border-right-color: rgb(100, 220, 255);
    border-bottom-color: rgb(100, 220, 255);
    border-left-color: rgb(100, 220, 255);
}


/* ================================================== */
/* GAME OVER BUTTON ENTER EFFECT                      */
/* Used by Restart and Exit buttons on Game Over.     */
/* ================================================== */

.game-over-button-enter {
    opacity: 0;
    scale: 0.85;

    transition-property: opacity, scale, background-color, border-top-color, border-right-color, border-bottom-color, border-left-color;
    transition-duration: 0.25s;
}

.game-over-button-enter-show {
    opacity: 1;
    scale: 1;
}

.game-over-button-enter-show:hover {
    scale: 1.08;

    background-color: rgba(60, 160, 210, 0.35);
    color: rgb(255, 255, 255);

    border-top-color: rgb(100, 220, 255);
    border-right-color: rgb(100, 220, 255);
    border-bottom-color: rgb(100, 220, 255);
    border-left-color: rgb(100, 220, 255);
}


/* ================================================== */
/* MAIN MENU                                          */
/* Centers the Play and Exit buttons vertically.      */
/* ================================================== */

.main-menu-panel {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    justify-content: center;
    align-items: center;
    flex-direction: column;
}

.menu-button {
    position: relative;
}

.play-button {
    margin-bottom: 24px;
}

.exit-button {
    margin-top: 0;
}


/* ================================================== */
/* RESTART BUTTON                                     */
/* Displayed on the Game Over screen.                 */
/* ================================================== */

.restart-button {
    position: absolute;

    left: 50%;
    top: 70%;

    translate: -50% -50%;

    width: 190px;
    height: 65px;

    font-size: 20px;
}


/* ================================================== */
/* ROTATE WARNING                                     */
/* Shown on mobile when the screen is in portrait.    */
/* ================================================== */

.rotate-warning-overlay {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    display: none;

    justify-content: center;
    align-items: center;

    background-color: rgba(5, 8, 18, 0.95);
}

.rotate-warning-text {
    color: rgb(255, 255, 255);
    background-color: rgba(16, 22, 39, 0.9);

    font-size: 28px;

    -unity-font-style: bold;
    -unity-text-align: middle-center;

    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;

    border-top-color: rgb(40, 133, 188);
    border-right-color: rgb(40, 133, 188);
    border-bottom-color: rgb(40, 133, 188);
    border-left-color: rgb(40, 133, 188);

    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;

    padding-top: 24px;
    padding-right: 32px;
    padding-bottom: 24px;
    padding-left: 32px;
}